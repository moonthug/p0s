{
  "name": "@p0s/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:hardware": "tsx scripts/testPrint.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seedTemplates.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-validator": "^0.9.1",
    "@inferdi/hono": "^6.1.1",
    "@inferdi/inferdi": "^6.1.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@moonthug/p0s-client": "workspace:*",
    "@p0s/shared": "workspace:*",
    "@sidequest/sqlite-backend": "^1.17.0",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.22",
    "hono-openapi": "^1.6.0",
    "mustache": "^4.2.0",
    "receiptline": "^4.0.4",
    "sharp": "^0.35.5",
    "sidequest": "^1.17.0",
    "tsx": "^4.23.15",
    "usb": "^2.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.6.10",
    "drizzle-kit": "^0.31.11"
  }
}
