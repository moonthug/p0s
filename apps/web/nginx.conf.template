server {
  listen 80;
  root /usr/share/nginx/html;

  # Image uploads; the API refuses anything over 15 MB itself.
  client_max_body_size 16m;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # /api/* → the API, with the prefix stripped (the Vite dev server does the same).
  location /api/ {
    proxy_pass ${API_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # Server-sent events (/api/events): don't buffer, and keep idle streams open.
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  # Hashed build assets never change.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Client-side routes (/jobs, /templates/…) all load the app.
  location / {
    try_files $uri /index.html;
  }
}
